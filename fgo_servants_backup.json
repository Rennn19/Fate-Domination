        "text": "I ask of you, are you my Master?"
      },
      {
        "title": "Noble Phantasm",
        "audioUrl": "https://res.cloudinary.com/mtns8net/video/upload/v1790104071/S002_NP2_naqnsi.ogg",
        "text": "This light is the planet's hope...proof of the life that illuminates this world! Behold! Ex... CALIBUR!"
      }
    ],
    "skills": [
      {
        "name": "Charisma A",
        "effect": "Increases ATK for all allies (3 turns)."
      },
      {
        "name": "Mana Burst A",
        "effect": "Increases Buster Performance for yourself (1 turn)."
      },
      {
        "name": "Intuition A",
        "effect": "Gains a large amount of Critical Stars."
      }
    ],
    "noblePhantasm": {
      "name": "Excalibur",
      "type": "Buster",
      "damageStat": "400% - 600% (Depends on NP Level)"
    },
    "traits": [
      "Dragon",
      "Female",
      "Humanoid",
      "King",
      "Riding",
      "Arthur"
    ],
    "lore": [
      "The legendary King of Knights who pulled the sword from the stone and united ancient Britain.",
      "Holder of the Holy Sword Excalibur, she wields the light of hope to protect mankind."
    ]
  },
